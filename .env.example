# Copy to .env and add your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
# Optional alias (some Expo setups load this automatically):
# EXPO_PUBLIC_GEMINI_API_KEY=your_api_key_here

# Optional: which Gemini model(s) to call. One id, or comma-separated fallback order.
# See https://ai.google.dev/gemini-api/docs/models
# Default chain tries gemini-2.5-flash, gemini-flash-latest, 2.0 variants, then gemini-3-flash-preview.
# Override if you hit rate limits (free tier): GEMINI_MODEL=gemini-2.0-flash-lite
# GEMINI_MODEL=gemini-2.5-flash,gemini-flash-latest

# Fake 311 demo sync (npm run 311-demo). Use your machine’s LAN IPv4 so the phone can reach it.
# FLICK_311_DEMO_URL=http://192.168.1.10:3110
